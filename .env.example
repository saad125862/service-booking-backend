# Local development values (docker compose overrides DATABASE_URL/SSL for the api container).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_booking
DATABASE_SSL=false
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=dev-admin-key-change-me
BUSINESS_TZ=Asia/Dhaka
CORS_ORIGINS=*
# Get a key at https://aistudio.google.com/ ; leave empty to disable the AI assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Online card / wallet payments (all optional). A gateway is offered to customers only when configured.
# PUBLIC_API_URL must be reachable from the customer's browser: gateways send them back to it.
PUBLIC_API_URL=http://localhost:3000
# SSLCommerz sandbox: register a free test store at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# aamarPay sandbox: see https://developer.aamarpay.com/ (public sandbox test keys are listed there)
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_SANDBOX=true
# Built-in pretend checkout for demos. On by default outside production, set true to also allow it in production.
GATEWAY_MOCK_ENABLED=true
