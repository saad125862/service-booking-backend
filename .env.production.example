# Variable NAMES for Render (set them in the dashboard; never commit real values).
NODE_ENV=production
# Render injects PORT automatically.
# Neon DIRECT connection string (host has no "-pooler"); migrations run on container start.
DATABASE_URL=
DATABASE_SSL=true
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=
BUSINESS_TZ=Asia/Dhaka
# Comma-separated origins, or * while testing the web preview.
CORS_ORIGINS=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
